DATABASE_URL="postgresql://user:password@localhost:5432/zalary?schema=public"
# HMAC secret for session tokens. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:4000"
# frostd relay for treasury key ceremonies and signing. Locally:
#   cargo install --git https://github.com/ZcashFoundation/frost-tools.git frostd
#   frostd --no-tls-very-insecure
FROSTD_URL="http://localhost:2744"
PORT=4000
