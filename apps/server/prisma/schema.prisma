generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(cuid())
  username             String           @unique
  name                 String?
  passwordHash         String
  tokenVersion         Int              @default(0)
  zcashViewingKey      String?
  walletBirthdayHeight Int?
  /// Set for delegates: the account whose payroll data this user manages.
  ownerId              String?
  owner                User?            @relation("Delegates", fields: [ownerId], references: [id], onDelete: Cascade)
  delegates            User[]           @relation("Delegates")
  delegateInvites      DelegateInvite[]
  employees            Employee[]
  payrolls             Payroll[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([ownerId])
}

/// Invite links carry the id plus an HMAC of it (see src/auth/invite.ts), so
/// nothing secret is stored here.
model DelegateInvite {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([ownerId])
}

enum SalaryCurrency {
  USD
  ZEC
}

model Employee {
  id             String            @id @default(cuid())
  name           String
  title          String?
  walletAddress  String
  walletVerified Boolean           @default(false)
  salaryAmount   Float
  salaryCurrency SalaryCurrency    @default(USD)
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  payrolls       PayrollEmployee[]
  payments       Payment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum Schedule {
  EVERY_TWO_WEEKS
  EVERY_MONTH
  EVERY_X_DAYS
}

model Payroll {
  id         String            @id @default(cuid())
  name       String
  schedule   Schedule
  customDays Int?
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  employees  PayrollEmployee[]
  payments   Payment[]
  runs       PayrollRun[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model PayrollEmployee {
  payrollId  String
  employeeId String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([payrollId, employeeId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model Payment {
  id         String        @id @default(cuid())
  employeeId String
  payrollId  String
  runId      String
  amountUsd  Float
  amountZec  Float
  memo       String        @unique
  status     PaymentStatus @default(PENDING)
  txHash     String?
  employee   Employee      @relation(fields: [employeeId], references: [id])
  payroll    Payroll       @relation(fields: [payrollId], references: [id])
  run        PayrollRun    @relation(fields: [runId], references: [id])
  createdAt  DateTime      @default(now())
}

enum PayrollRunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model PayrollRun {
  id          String           @id @default(cuid())
  payrollId   String
  status      PayrollRunStatus @default(PENDING)
  zecPriceUsd Float
  payroll     Payroll          @relation(fields: [payrollId], references: [id])
  payments    Payment[]
  createdAt   DateTime         @default(now())
  completedAt DateTime?
}
